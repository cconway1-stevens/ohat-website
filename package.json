{
  "name": "ocean-heights-auto-repair",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "bash dev/scripts/install-ci.sh",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "bash dev/scripts/build-verified.sh",
    "build:static": "node dev/scripts/generate-image-variants.mjs && STATIC_EXPORT=1 vinext build && node dev/scripts/build-static.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test dev/tests/shop-hours.test.mjs dev/tests/chat-answers.test.mjs dev/tests/pixel-crew.test.mjs dev/tests/arcade.test.mjs dev/tests/rendered-html.test.mjs dev/tests/service-seo.test.mjs && npm run build:static && node --test dev/tests/static-export.test.mjs dev/tests/routes.test.mjs",
    "report": "node dev/scripts/run-tests-report.mjs",
    "qa:production": "node dev/scripts/production-readiness.mjs",
    "validate:artifact": "bash dev/scripts/validate-artifact.sh",
    "lint": "biome lint .",
    "lint:next": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bash dev/scripts/pre-push.sh",
    "check:fix": "bash dev/scripts/pre-push.sh --fix",
    "check:assets": "node dev/scripts/check-assets.mjs",
    "check:bloat": "node dev/scripts/check-bloat.mjs",
    "check:bundle": "node dev/scripts/check-bundle.mjs",
    "check:lighthouse": "node dev/scripts/check-lighthouse.mjs",
    "check:lighthouse:fast": "node dev/scripts/check-lighthouse.mjs --fast",
    "check:a11y": "node dev/scripts/check-a11y.mjs",
    "check:deadcode": "knip",
    "check:architecture": "depcruise src dev --config .dependency-cruiser.cjs",
    "check:pages": "node dev/scripts/check-pages.mjs",
    "check:slow-network": "node dev/scripts/check-slow-network.mjs",
    "check:memory": "node dev/scripts/check-memory.mjs",
    "check:all": "bash dev/scripts/check-all.sh"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tetris-kit": "^0.0.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/vite-plugin": "1.54.3",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "^4.11.4",
    "dependency-cruiser": "^18.2.0",
    "eslint": "9.39.4",
    "fuse.js": "^7.5.0",
    "knip": "^6.34.0",
    "lighthouse": "13.4.1",
    "playwright": "^1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.128.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
