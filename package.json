{
  "name": "ocean-heights-auto-repair",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "patch-package",
    "install:ci": "bash dev/scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "build": "bash dev/scripts/build-verified.sh",
    "build:static": "node dev/scripts/generate-image-variants.mjs && STATIC_EXPORT=1 vinext build && node dev/scripts/build-static.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test dev/tests/shop-hours.test.mjs dev/tests/rendered-html.test.mjs dev/tests/service-seo.test.mjs && npm run build:static && node --test dev/tests/static-export.test.mjs",
    "qa:production": "node dev/scripts/production-readiness.mjs",
    "validate:artifact": "bash dev/scripts/validate-artifact.sh",
    "lint": "bash dev/scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "bash dev/scripts/pre-push.sh",
    "check:fix": "bash dev/scripts/pre-push.sh --fix",
    "check:assets": "node dev/scripts/check-assets.mjs"
  },
  "dependencies": {
    "@blackjacktrainer/blackjack-simulator": "^0.35.14",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "simple-icons": "^16.10.0",
    "tetris-kit": "^0.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "prettier": {
    "printWidth": 100,
    "proseWrap": "preserve"
  }
}
