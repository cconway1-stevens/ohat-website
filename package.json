{
  "name": "ocean-heights-auto-repair",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "bash dev/scripts/install-ci.sh",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "bash dev/scripts/build-verified.sh",
    "build:static": "node dev/scripts/generate-image-variants.mjs && node dev/scripts/build-static-export.mjs && node dev/scripts/build-static.mjs",
    "clean": "node dev/scripts/clean.mjs",
    "clean:deep": "node dev/scripts/clean.mjs --deep",
    "start": "vinext start",
    "test:unit": "node --test --test-isolation=none \"dev/tests/unit/*.test.mjs\"",
    "test:server": "node --test \"dev/tests/server/*.test.mjs\"",
    "test:static": "node --test \"dev/tests/static/*.test.mjs\"",
    "test": "npm run test:unit && npm run build:static && npm run test:server && npm run test:static",
    "report": "node dev/scripts/run-tests-report.mjs",
    "qa:production": "node dev/scripts/production-readiness.mjs",
    "ci:report": "node dev/scripts/ci-report.mjs",
    "validate:artifact": "bash dev/scripts/validate-artifact.sh",
    "lint": "biome lint .",
    "lint:next": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bash dev/scripts/pre-push.sh",
    "check:fix": "bash dev/scripts/pre-push.sh --fix",
    "check:assets": "node dev/scripts/check-assets.mjs",
    "check:browser:preflight": "node dev/scripts/check-browser.mjs",
    "check:browser": "node dev/scripts/check-browser-suite.mjs",
    "check:browser:full": "node dev/scripts/check-browser-suite.mjs --full",
    "check:bloat": "node dev/scripts/check-bloat.mjs",
    "check:bundle": "node dev/scripts/check-bundle.mjs",
    "check:lighthouse": "node dev/scripts/check-lighthouse.mjs",
    "check:lighthouse:fast": "node dev/scripts/check-lighthouse.mjs --fast",
    "check:a11y": "node dev/scripts/check-a11y.mjs",
    "check:deadcode": "knip",
    "check:architecture": "depcruise src dev --config .dependency-cruiser.cjs",
    "check:pages": "node dev/scripts/check-pages.mjs",
    "check:privacy": "node dev/scripts/check-privacy.mjs",
    "check:a11y-statement": "node dev/scripts/check-accessibility-statement.mjs",
    "check:slow-network": "node dev/scripts/check-slow-network.mjs",
    "check:memory": "node dev/scripts/check-memory.mjs",
    "check:all": "bash dev/scripts/check-all.sh",
    "readme": "node dev/scripts/build-readme.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "klaro": "^0.7.18",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tetris-kit": "^0.0.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "9.39.5",
    "fuse.js": "^7.5.0",
    "knip": "^6.41.0",
    "lighthouse": "13.5.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
